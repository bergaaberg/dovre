# Settings for Dovre on a server. The rest can be set on Settings once it runs.

# The one public address your sign-in proxy serves Dovre at: exactly https://host[:port].
# Whatever reaches it reaches the terminals and agents, so keep a sign-in in front (docs/SELF-HOST.md).
PUBLIC_ORIGIN=https://dovre.example.com

# GitHub: a token (no `gh` on the server) and the owners whose repos Dovre shows.
GITHUB_TOKEN=
REPO_OWNERS=

# Optional: pin the login token instead of the one made in data/launch-token (16+ of A-Z a-z 0-9 _ -).
# LAUNCH_TOKEN=

# Optional: the timezone for dates and greetings.
# TZ_NAME=Europe/Oslo
