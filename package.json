{
  "name": "dovre",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "exports": {
    "./pack.ts": "./src/pack.ts",
    "./pack-testing.ts": "./src/pack-testing.ts",
    "./worker.ts": "./src/worker.ts",
    "./hosted/hub.ts": "./src/hosted/hub.ts",
    "./hosted/lookups.ts": "./src/hosted/lookups.ts",
    "./packs/core/assistant/bino/lookups.ts": "./src/packs/core/assistant/bino/lookups.ts",
    "./writes.ts": "./src/writes.ts",
    "./onboarding.ts": "./src/onboarding.ts",
    "./demo/worker.ts": "./src/demo/worker.ts",
    "./demo/fixtures.ts": "./src/demo/fixtures.ts",
    "./env.ts": "./src/env.ts",
    "./format.ts": "./src/format.ts",
    "./gather.ts": "./src/gather.ts",
    "./html.ts": "./src/html.ts",
    "./actor.ts": "./src/actor.ts",
    "./viewer.ts": "./src/viewer.ts",
    "./strict.ts": "./src/strict.ts",
    "./access.ts": "./src/access.ts",
    "./bridge/wire.ts": "./src/bridge/wire.ts",
    "./ui/kit.ts": "./src/ui/kit.ts",
    "./ui/charts.view.ts": "./src/ui/charts.view.ts",
    "./pages/parts.ts": "./src/pages/parts.ts",
    "./actions/deploys.ts": "./src/actions/deploys.ts",
    "./packs/types.ts": "./src/packs/types.ts"
  },
  "description": "Dovre: the view from the top. A cockpit over your repos, your apps and your coding agents.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "bridge": "node src/bridge/main.ts",
    "build:bridge": "esbuild src/bridge/main.ts src/spawn-worker.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist/bridge --entry-names=[name] --out-extension:.js=.mjs --log-level=warning \"--banner:js=import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "packs": "node src/packs/new.ts",
    "instance": "node src/instance-new.ts",
    "phone": "node src/phone-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit --test-timeout=120000 \"test/*.test.ts\" \"src/packs/core/*/test/*.test.ts\"",
    "test:go": "go -C launcher test ./...",
    "check": "pnpm typecheck && pnpm test && pnpm test:go"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "~0.25.12",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "memlet": "https://codeload.github.com/bergaaberg/memlet/tar.gz/cfd1c53db638259c39431d611caed52562cac534"
  }
}
